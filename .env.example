# ============================================================
# AHAWC Distribution Portal - Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@host.neon.tech/dbname?sslmode=require

# NextAuth
NEXTAUTH_SECRET=your-32-character-random-secret-here
# Local only. Keep this in sync with the port your dev server actually uses.
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Email of the super-admin user (auto-promoted to admin on Google OAuth login)
SUPER_ADMIN_EMAIL=alex@ahawc.com

# Rate limiting (Upstash Redis — https://console.upstash.com)
# If not set, login rate limiting is disabled (not recommended in production)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Telnyx (SMS + Voice)
TELNYX_API_KEY=KEY...
TELNYX_FROM_NUMBER=+15550000000
TELNYX_CALL_CONTROL_ID=   # Call Control Application ID from Telnyx portal (required for outbound voice calls)
# Phone number to receive SMS alerts on new inbound texts
ADMIN_NOTIFICATION_PHONE=+15550000000
# Staff notification phone numbers — set these instead of hardcoding
STAFF_NOTIFICATION_PHONE_2=+1...   # e.g. Kim's phone (+12489339350)
ORDER_NOTIFY_KRISTEN_PHONE=+1...
# Staff notification email addresses — used for order/delivery/tasting alerts
ORDER_NOTIFY_KIM_EMAIL=kim@ahawc.com
ORDER_NOTIFY_KIM_EMAIL_2=sales@wishervodka.com
ORDER_NOTIFY_KRISTEN_EMAIL=kristen@...

# Rep-assisted customer order links and sales-rep controls
REP_ASSISTED_LINK_EXPIRY_HOURS=168
REP_MAX_DISCOUNT_PERCENT=10

# Resend (Email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@ahawc.com
# Operational email recipients (fallback / external contacts not in the portal)
WHOLESALE_REQUEST_NOTIFICATION_EMAIL=admin@ahawc.com
SAMPLE_CASE_ALERT_EMAIL=kris@ahawc.com
TASTER_ACCOUNTING_EMAIL=kris@ahawc.com
# Comma-separated monthly inventory report recipients. If omitted, active portal
# users named Kris, Kim, Alex, or Emily with an admin/staff role are used.
MONTHLY_INVENTORY_REPORT_EMAILS=kris@ahawc.com,kim@ahawc.com,alex@ahawc.com,emily@ahawc.com

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GCS_BUCKET_NAME=ahawc-portal-storage

# Google Maps
GOOGLE_MAPS_API_KEY=AIza...          # Server-side (Geocoding API)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...  # Client-side (Maps JS API - restrict by HTTP referrer)

# HubSpot
HUBSPOT_API_KEY=pat-na1-...

# Google Chat
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...
